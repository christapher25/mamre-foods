# Copy to .env for local development. Never commit .env. No real secrets here.
# Doc 2 section 13 required variables.

# Local dev only. Required when DEBUG is off.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Defaults to SQLite for local dev only. Production uses PostgreSQL 16.
DATABASE_URL=sqlite:///db.sqlite3
# PENDING P-7: business time zone becomes an Admin setting later.
TIME_ZONE=UTC
# Not wired up in P0 (Sentry is a later phase).
SENTRY_DSN=
# Login and refresh rate limit (Doc 2 s8), a DRF rate such as 10/min or 5/min.
AUTH_THROTTLE_RATE=10/min
